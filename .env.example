# Supabase (keep existing)
NEXT_PUBLIC_SUPABASE_URL=your_existing_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_existing_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_existing_service_role_key

# Cloudflare R2 (NEW - replace Cloudinary)
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=life-archive
R2_PUBLIC_DOMAIN=https://life-archive.{ACCOUNT_ID}.r2.dev

# Optional (keep if using)
RESEND_API_KEY=your_resend_api_key
INVITE_FROM_EMAIL=Life Archive <onboarding@resend.dev>
NODE_ENV=development
